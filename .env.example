# ── Hybrid RAG Configuration ──────────────────────────────────────

# LLM Provider: "huggingface" (default) or "groq"
LLM_PROVIDER=huggingface

# HuggingFace API Token (required for huggingface provider)
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=

# HuggingFace Model (default: openai/gpt-oss-20b)
HF_MODEL=openai/gpt-oss-20b
HF_MAX_NEW_TOKENS=512
HF_REPETITION_PENALTY=1.03

# Groq settings (only needed if LLM_PROVIDER=groq)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (runs locally via SentenceTransformer, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
SIMILARITY_THRESHOLD=0.35
HIGH_CONFIDENCE_THRESHOLD=0.50

# Reranker (runs locally via CrossEncoder)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=3

# Paths
DATA_DIRECTORY=data
INDEX_PATH=vectorstore/index.faiss
CHUNKS_PATH=vectorstore/chunks.pkl
